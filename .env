# Only the host-side ports change on another server; internal ports stay fixed.
API_PORT=8001
UI_PORT=8501

# Safe default: API accepts local curl / SSH tunnel; UI is reachable externally.
API_BIND_IP=127.0.0.1
UI_BIND_IP=0.0.0.0

COMPOSE_PROJECT_NAME=task-agent
APP_IMAGE=task-agent:1.0.0
